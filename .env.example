# Скопируй в .env и впиши свой ключ:  cp .env.example .env
# Нужен ключ только для выбранного мозга (llm.provider в config.json).

# xAI Grok (по умолчанию): https://console.x.ai -> API Keys
XAI_API_KEY=

# OpenAI (если llm.provider = openai-luna / openai-terra): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Необязательно: переопределить мозг без правки config.json
# COMPANION_LLM=openai-luna
# COMPANION_DEBUG=1
